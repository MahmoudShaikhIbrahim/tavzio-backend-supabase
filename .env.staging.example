# Staging environment template. Copy this to .env (in the STAGING worktree
# folder only, e.g. tavzio-backend-supabase-staging/.env) and fill in real
# staging values. This file itself never holds real secrets - it's just the
# shape, same as .env.example.
#
# The one rule this whole file exists to enforce: nothing in here should
# ever point at a real customer, a real payment, or a real email inbox.

NODE_ENV=development
PORT=5000

# The STAGING Supabase project - a different project from production, with
# its own URL and keys. Create it once, run every file in
# supabase/migrations/ against it in order (see MIGRATIONS_CHECKLIST.md),
# then paste its values here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CLIENT_URL=http://localhost:5173
# Your staging frontend URL once it's live, e.g. https://staging.tavzio.ae
PUBLIC_BASE_URL=

# Real Resend key is fine to reuse (Resend doesn't have a sandbox mode),
# but be deliberate about who might actually receive an email while
# testing on staging - consider leaving this blank while building a
# feature, and only filling it in when you specifically need to test an
# email flow, so nothing goes out to a real inbox by accident.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Tavzio Staging <invites@tavzio.ae>
RESEND_BILLING_FROM_ADDRESS=Tavzio Staging Billing <billing@tavzio.ae>
RESEND_SECURITY_FROM_ADDRESS=Tavzio Staging Security <security@tavzio.ae>
RESEND_CAMPAIGNS_FROM_ADDRESS=Tavzio Staging Campaigns <campaigns@tavzio.ae>

# Same reasoning as Resend above - leave blank unless you're specifically
# testing the OTP flow, so staging never sends a real SMS to a real phone.
MC_CUSTOMER_ID=
MC_PASSWORD=
MC_EMAIL=

# Fine to reuse the real Turnstile secret - it's a bot-check, not a
# payment or customer-data risk.
TURNSTILE_SECRET_KEY=

# ZIINA'S SANDBOX KEY, NOT THE LIVE ONE. This is the single most important
# line in this file - a live key here means a "test" transaction on
# staging is a real charge. Get the sandbox key from Ziina's own
# dashboard, not by copying the production value.
ZIINA_API_KEY=
ZIINA_BASE_URL=https://api-v2.ziina.com/api
ZIINA_WEBHOOK_SECRET=
SCRIPZIO_ZIINA_WEBHOOK_URL=

GOOGLE_TRANSLATE_API_KEY=
SUPABASE_JWT_SECRET=

REQUIRE_DEVICE_CONFIRMATION=false
ENABLE_ADMIN_LOGIN_ALERTS=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=alerts@tavzio.com
