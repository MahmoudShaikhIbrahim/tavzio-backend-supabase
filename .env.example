NODE_ENV=development
PORT=5000

# From Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
# Service role key — server-side only, NEVER expose to the frontend.
# Bypasses RLS, so used only for signup (creating business+profile together)
# and event writes (tap/click tracking from anonymous customers).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=https://tavzio.com

# Project Settings → API → JWT Settings → JWT Secret. NOT currently used —
# this project's JWT Signing Keys are asymmetric (ECC), confirmed in
# Project Settings → JWT Signing Keys, so admin sessions are issued via
# Supabase's own generateLink+verifyOtp flow instead of self-signing.
# Left here in case that ever changes — see src/utils/tapSession.js.
SUPABASE_JWT_SECRET=

# --- Both off by default: tap = instant login, no email step, no alerts. ---
# Flip to 'true' later if you want a stricter mode: an unrecognized device
# gets a confirm-by-email step before it's allowed in, and every admin
# login sends a "your card was just used" email. No code changes needed —
# just these two flags.
REQUIRE_DEVICE_CONFIRMATION=false
ENABLE_ADMIN_LOGIN_ALERTS=false

# SMTP for the two flags above, if/when you turn them on. Any provider
# works (Zoho, Gmail, Resend, etc.) — plug in whichever you're already using.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=alerts@tavzio.com
