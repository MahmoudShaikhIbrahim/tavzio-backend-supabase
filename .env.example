NODE_ENV=development
PORT=5000

# From Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
# Service role key — server-side only, NEVER expose to the frontend.
# Bypasses RLS, so used only for signup (creating business+profile together)
# and event writes (tap/click tracking from anonymous customers).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=https://tavzio.com

# Resend - sends staff/organization-owner invite emails AND billing
# correspondence (receipts, payment failures, suspension, termination
# notices) on Tavzio's own verified domain (tavzio.ae) - never Supabase's
# own mailer, and never Gmail (Gmail stays for contracts only - see
# GMAIL_* below). Two distinct sender identities on purpose: invites
# read as "Tavzio invited you," billing reads as "the billing system" -
# get the API key from resend.com > API keys, scoped to "Sending access"
# only and to the tavzio.ae domain specifically, not "Full access" /
# "All domains", since this Resend account is shared with other
# Tavzio-family products. Emails silently fail to send (logged, not
# thrown) if RESEND_API_KEY is unset.
RESEND_API_KEY=
# Must be on the domain verified in Resend (Domains > tavzio.ae). Format:
# "Display Name <local-part@tavzio.ae>".
RESEND_FROM_ADDRESS=Tavzio <invites@tavzio.ae>
RESEND_BILLING_FROM_ADDRESS=Tavzio Billing <billing@tavzio.ae>
# Card-tap alerts + new-device confirmation - both account-security
# notices, one identity.
RESEND_SECURITY_FROM_ADDRESS=Tavzio Security <security@tavzio.ae>
# A business's own campaign emails to ITS customers, sent through
# Tavzio - named for the feature, not "marketing@" (which would read as
# Tavzio's own marketing to prospects, which this isn't).
RESEND_CAMPAIGNS_FROM_ADDRESS=Tavzio Campaigns <campaigns@tavzio.ae>

# Message Central (Verify Now) - sends and validates the phone
# verification (OTP) code for online booking. This is the ONLY thing SMS
# is used for anywhere in this app - SMS marketing campaigns are
# explicitly blocked without this being set (see marketingController.js).
# MC_CUSTOMER_ID and MC_PASSWORD come from your Message Central console
# (Setting page) - MC_PASSWORD is your console login password, base64
# encoded internally before use. MC_EMAIL is the account email. OTP
# sends silently fail (logged, not thrown) if any of these three are
# unset.
MC_CUSTOMER_ID=
MC_PASSWORD=
MC_EMAIL=

# Cloudflare Turnstile - bot protection on the login form (AdminLogin.tsx).
# Get both from the Cloudflare dashboard: Turnstile > Add site. The site
# key is public (also goes in the frontend's VITE_TURNSTILE_SITE_KEY);
# the secret key is server-only, never exposed to the frontend. Login
# still works with this unset (verifyTurnstileToken fails open when the
# secret is missing) - set it once you've created a Turnstile site to
# actually turn enforcement on.
TURNSTILE_SECRET_KEY=

# Ziina - same shared account as Scripzio, so ZIINA_API_KEY, ZIINA_BASE_URL,
# and ZIINA_WEBHOOK_SECRET can be copied directly from Scripzio's own env
# vars (same values, same account). SCRIPZIO_ZIINA_WEBHOOK_URL is the one
# NEW value: Scripzio's real webhook URL, so Tavzio can forward anything
# that isn't its own receipt back to it, keeping Scripzio unaffected.
ZIINA_API_KEY=
ZIINA_BASE_URL=https://api-v2.ziina.com/api
ZIINA_WEBHOOK_SECRET=
SCRIPZIO_ZIINA_WEBHOOK_URL=https://astonishing-harmony-production-2088.up.railway.app/api/billing/ziina-webhook

# Google Cloud Console → APIs & Services → Credentials. Used to
# auto-translate owner-written content (menu items, descriptions, custom
# button labels, loyalty reward text) into every language the customer
# side supports. If this is missing or invalid, saves still work fine -
# translations are simply skipped and the original text is shown to
# every customer regardless of their selected language.
GOOGLE_TRANSLATE_API_KEY=

# Project Settings → API → JWT Settings → JWT Secret. NOT currently used —
# this project's JWT Signing Keys are asymmetric (ECC), confirmed in
# Project Settings → JWT Signing Keys, so admin sessions are issued via
# Supabase's own generateLink+verifyOtp flow instead of self-signing.
# Left here in case that ever changes — see src/utils/tapSession.js.
SUPABASE_JWT_SECRET=

# --- Both off by default: tap = instant login, no email step, no alerts. ---
# Flip to 'true' later if you want a stricter mode: an unrecognized device
# gets a confirm-by-email step before it's allowed in, and every admin
# login sends a "your card was just used" email. No code changes needed —
# just these two flags.
REQUIRE_DEVICE_CONFIRMATION=false
ENABLE_ADMIN_LOGIN_ALERTS=false

# SMTP for the two flags above, if/when you turn them on. Any provider
# works (Zoho, Gmail, Resend, etc.) — plug in whichever you're already using.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=alerts@tavzio.com
